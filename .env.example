# ---- Database -------------------------------------------------------------
POSTGRES_USER=hytte
POSTGRES_DB=hytte
# Generate with: openssl rand -hex 24
# Special characters (/ + @ :) are fine — they are percent-encoded at startup.
POSTGRES_PASSWORD=

# ---- Application ----------------------------------------------------------
# Used to sign session cookies and encrypt stored integration credentials.
# Generate with: openssl rand -base64 48
# Changing this invalidates all sessions and all stored integration secrets.
APP_SECRET=

# Pre-configured administrator, created on first start.
ADMIN_EMAIL=admin@hytte.local
ADMIN_NAME=Administrator
# Must satisfy the password policy below. You are prompted to change it on
# first login.
ADMIN_PASSWORD=

# ---- Password policy ------------------------------------------------------
# Default (unset or false): at least 12 characters, and a digit or symbol.
# Set to true on a closed, trusted network to allow simple passwords —
# 4 characters minimum, no complexity requirement.
#
# This affects user passwords only. APP_SECRET is an encryption key, not a
# password, and always has to be long. Turning this off again does not
# invalidate passwords already set, so change them at the same time.
ALLOW_WEAK_PASSWORDS=false

# ---- Networking -----------------------------------------------------------
# 127.0.0.1 = local only. Use 0.0.0.0 to reach it from the LAN.
BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Required once the app is reachable over a hostname (e.g. behind a Cloudflare
# Tunnel). Comma-separated, including scheme, no trailing slash.
# ALLOWED_ORIGINS=https://hytte.example.com
ALLOWED_ORIGINS=

# Set to true only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=false
